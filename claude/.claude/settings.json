{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(cat:*)",
      "Bash(git branch:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git merge-base:*)",
      "Bash(git rev-parse:*)",
      "Bash(wc:*)",
      "Bash(chmod:*)",
      "Bash(echo:*)",
      "Bash(find:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr view:*)",
      "Bash(git ls:*)",
      "Bash(git show:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(npm run build:*)",
      "Bash(npm run compile:*)",
      "Bash(npm run eslint:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run prettier:*)",
      "Bash(npm run test:*)",
      "Bash(npm ls:*)",
      "Bash(npm explain:*)",
      "Bash(npm info:*)",
      "Bash(npm show:*)",
      "Bash(npm test:*)",
      "Bash(npm view:*)",
      "Bash(npx nx build:*)",
      "Bash(npx nx test:*)",
      "Bash(nx build:*)",
      "Bash(nx test:*)",
      "Bash(rg:*)",
      "Bash(sbt:*)",
      "Bash(tail:*)",
      "Read(//tmp/**)",
      "Read(~/Sandbox/tmp/**)",
      "Edit(//tmp/**)",
      "Edit(~/Sandbox/tmp/**)"
    ],
    "deny": [],
    "ask": [],
    "defaultMode": "default"
  },
  "statusLine": {
    "type": "command",
    "command": "npx -y ccstatusline@latest",
    "padding": 0
  },
  "enabledPlugins": {
    "pr-review-toolkit@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": true
  },
  "alwaysThinkingEnabled": true
}
